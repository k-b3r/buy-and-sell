DASHBOARD_PASSWORD="choose-a-real-password-here"

# This app no longer talks to Postgres directly. The database lives on the
# VPS and listens on localhost only, so every query goes through server/'s
# POST /query (see src/lib/queries.ts) over the same authenticated tunnel the
# refresh/logs/worker-control routes already use. REFRESH_API_KEY must match
# server/.env's value.
#
# There is deliberately no DATABASE_URL here - if this app could reach the
# database directly it would defeat the point of the named-query whitelist.
REFRESH_SERVER_URL="https://refresh.kber.dev"
REFRESH_API_KEY="<same as server/.env>"
