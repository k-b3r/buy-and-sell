DASHBOARD_PASSWORD="choose-a-real-password-here"

# This app does not talk to Postgres directly. The database lives on the VPS
# and listens on localhost only, so every read and write goes through server/'s
# resource routes (see src/lib/api.ts and src/lib/queries.ts), and the browser's
# /api/* calls are rewritten there by src/proxy.ts, over the same authenticated
# tunnel. REFRESH_API_KEY must match server/.env's value.
#
# There is deliberately no DATABASE_URL here - if this app could reach the
# database directly, a leaked key would no longer be limited to the routes
# the server ships.
REFRESH_SERVER_URL="https://refresh.kber.dev"
REFRESH_API_KEY="<same as server/.env>"
