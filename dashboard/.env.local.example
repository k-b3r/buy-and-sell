DATABASE_URL="postgresql://..."
DASHBOARD_PASSWORD="choose-a-real-password-here"

# For the "Refresh" listing button (src/app/api/listings/[id]/refresh) - hands
# off to server/'s POST /refresh, running on the box with Playwright/Chromium
# (this dashboard can't run a full browser session). REFRESH_API_KEY must
# match server/.env's value; without both set the button 503s gracefully.
REFRESH_SERVER_URL="http://<server-host>:8787"
REFRESH_API_KEY="<same as server/.env>"
