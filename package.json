{
  "name": "marketplace-collector",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.33.3",
  "scripts": {
    "prepare": "if [ -e .git ]; then lefthook install; fi",
    "test": "vitest run",
    "collect": "tsx src/workers/collect/index.ts",
    "backfill-images": "tsx src/utils/backfill/index.ts",
    "extract-products": "tsx src/workers/extract-products/index.ts",
    "price-lookup": "tsx src/workers/price-lookup/index.ts",
    "price-from-listings": "tsx src/utils/price-from-listings/index.ts",
    "check-listings": "tsx src/workers/check-listings/index.ts",
    "enrich-products": "tsx src/workers/enrich-products/index.ts",
    "flag-price-ineligible": "tsx src/utils/flag-price-ineligible/index.ts",
    "enrich-listing-prices": "tsx src/workers/enrich-listing-prices/index.ts",
    "extract-real-estate": "tsx src/workers/extract-real-estate/index.ts",
    "verify-discount-notifications": "tsx src/workers/verify-discount-notifications/index.ts",
    "merge-duplicate-products": "tsx src/utils/merge-duplicate-products/index.ts",
    "triage-excluded-products": "tsx src/utils/triage-excluded-products/index.ts",
    "detect-generic-products": "tsx src/utils/detect-generic-products/index.ts",
    "detect-model-mismatches": "tsx src/utils/detect-model-mismatches/index.ts",
    "reassign-model-mismatches": "tsx src/utils/reassign-model-mismatches/index.ts",
    "gen-arch-doc": "tsx scripts/gen-arch-doc.ts",
    "gen-dashboard-shared": "tsx scripts/gen-dashboard-shared.ts",
    "docs:dev": "vitepress dev docs-site",
    "docs:build": "vitepress build docs-site",
    "docs:publish": "pnpm gen-arch-doc && pnpm docs:build && rm -rf dashboard/public/docs && mkdir -p dashboard/public && cp -r docs-site/.vitepress/dist dashboard/public/docs",
    "deploy:server": "./scripts/deploy-server.sh",
    "tunnel": "./scripts/tunnel.sh",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "depcruise": "depcruise src server --config .dependency-cruiser.cjs",
    "knip": "TEST_DATABASE_URL=${TEST_DATABASE_URL:-postgres://knip@localhost/unused} knip --no-progress",
    "docs:check": "pnpm gen-arch-doc && git diff --exit-code -- docs-site",
    "typecheck": "tsc --noEmit -p . && tsc --noEmit -p server && tsc --noEmit -p dashboard",
    "check": "pnpm format:check && pnpm lint && pnpm depcruise && pnpm knip && pnpm typecheck && pnpm test",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/js": "^10.0.1",
    "@k-b3r/agent-config": "github:k-b3r/agent-config",
    "@next/eslint-plugin-next": "^16.3.8",
    "@playwright/test": "1.62.1",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.23.1",
    "dependency-cruiser": "^18.5.0",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "knip": "^6.39.0",
    "lefthook": "^2.1.16",
    "playwright": "^1.47.0",
    "prettier": "^3.9.9",
    "ts-morph": "^28.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.71.0",
    "vitepress": "^1.6.4",
    "vitest": "^2.1.0"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1113.0",
    "@google/genai": "^2.18.0",
    "groq-sdk": "^1.5.0",
    "pg": "^8.23.0",
    "sharp": "^0.35.3",
    "socks": "^2.8.9"
  },
  "overrides": {
    "standardwebhooks": "1.0.0"
  },
  "agentConfig": {
    "sourceDirs": [
      "src",
      "server"
    ],
    "entries": [
      "src/workers/*/index.ts",
      "src/utils/*/index.ts"
    ],
    "appDbEnv": "DATABASE_URL"
  }
}
