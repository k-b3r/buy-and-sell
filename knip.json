{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "ignore": ["dashboard/**"],
  "ignoreBinaries": ["pg_dump"],
  "workspaces": {
    ".": {
      "entry": ["src/**/index.ts", "src/**/*.test.ts", "scripts/*.{ts,mjs}", "tests/**/*.ts"],
      "project": ["src/**/*.ts", "scripts/**/*.{ts,mjs}", "tests/**/*.ts"]
    },
    "server": {
      "entry": ["**/*.test.ts"],
      "project": ["**/*.ts"],
      "ignoreDependencies": ["@aws-sdk/client-s3", "pg", "@types/pg", "playwright", "sharp", "socks"]
    }
  }
}
