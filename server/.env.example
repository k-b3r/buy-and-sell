DATABASE_URL="postgresql://server_service:<password>@ep-dry-lab-aziav5ac-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

REFRESH_API_KEY="<generate a strong random secret>"
SERVER_PORT="8787"

# No direct-IP fallback - Facebook walls Hetzner's datacenter IP (see
# proxyGuard.ts). Every refresh request fails closed (503, no action taken)
# unless one of these two actually works.
#
# Tried first: Webshare's rotating residential proxy
# (https://www.webshare.io/rotating-proxy). Full URL, credentials from your
# Webshare dashboard - either http:// (port 80) or socks5:// endpoint both
# work, the reachability check dispatches on scheme.
WEBSHARE_PROXY="http://username:password@p.webshare.io:80"

# Falls back to this if WEBSHARE_PROXY is unset or unreachable - the
# laptop-relayed ssh -R tunnel (see scripts/tunnel.sh).
SOCKS_PROXY="socks5://127.0.0.1:1080"

R2_ACCOUNT_ID="<same as root .env>"
R2_ACCESS_KEY_ID="<same as root .env>"
R2_SECRET_KEY="<same as root .env>"
R2_BUCKET_NAME="<same as root .env>"
R2_PUBLIC_BASE_URL="<same as root .env>"
