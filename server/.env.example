DATABASE_URL="postgresql://server_service:<password>@ep-dry-lab-aziav5ac-pooler.c-3.ap-southeast-1.aws.neon.tech/neondb?sslmode=verify-full&channel_binding=require"

REFRESH_API_KEY="<generate a strong random secret>"
SERVER_PORT="8787"

# Required, no direct-IP fallback - Facebook walls Hetzner's datacenter IP
# (see tunnelGuard.ts). Every refresh request fails closed (503, no action
# taken) if this isn't set or the laptop-side ssh -R tunnel isn't reachable.
SOCKS_PROXY="socks5://127.0.0.1:1080"

R2_ACCOUNT_ID="<same as root .env>"
R2_ACCESS_KEY_ID="<same as root .env>"
R2_SECRET_KEY="<same as root .env>"
R2_BUCKET_NAME="<same as root .env>"
R2_PUBLIC_BASE_URL="<same as root .env>"
